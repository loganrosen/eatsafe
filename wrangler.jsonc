{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eatsafe",
  "compatibility_date": "2026-07-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Routes for eatsafe.nyc are managed in loganrosen/cloudflare-infra (Terraform).
  // Declaring them here makes wrangler replace them on every deploy, which churns their IDs.
  "workers_dev": false,
  "preview_urls": false
}
