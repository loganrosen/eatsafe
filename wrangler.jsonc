{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eatsafe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Routes for eatsafe.nyc are managed in loganrosen/cloudflare-infra (Terraform).
  // Declaring them here makes wrangler replace them on every deploy, which churns their IDs.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      // Created by cloudflare-infra (cloudflare_d1_database.eatsafe).
      "database_name": "eatsafe",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "ALERTS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "VAPID_PUBLIC_KEY": "REPLACE_WITH_VAPID_PUBLIC_KEY",
    "VAPID_SUBJECT": "https://eatsafe.nyc"
  },
  // Set with `wrangler secret put VAPID_PRIVATE_JWK`.
  "secrets": {
    "required": ["VAPID_PRIVATE_JWK"]
  }
}
